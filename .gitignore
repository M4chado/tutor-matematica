# Ambiente virtual (cada computador cria o seu)
.venv/

# Dataset e dados processados (grandes demais para o Git)
data/raw/
data/processed/*
!data/processed/.gitkeep

# Modelos treinados (arquivos grandes)
models/*
!models/.gitkeep
*.keras
*.h5
*.npz

# Fotos tiradas pelo usuário para testar (podem ser grandes)
fotos_teste/
capturas/
# Figura gerada com as fotos reais do usuário (mostra pessoa e ambiente: privacidade)
reports/figuras/teste_fotos_usuario.png

# Arquivos temporários do Python e dos testes
__pycache__/
*.pyc
.pytest_cache/

# Imagens geradas para o banner (grandes; refaça com: python banner/gerar_banner.py)
banner/*.png
# Modelo do banner do Workshop (3,7 MB; fica só no computador)
Banner Workshop IA.png

# Registro da última abertura do tutor (iniciar.bat)
iniciar.log

# Arquivos do Gradio e do sistema
.gradio/
flagged/
Thumbs.db
.vscode/
